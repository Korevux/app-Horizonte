// Configuración de Cloudflare Workers (lo usa "npx wrangler deploy").
{
  "name": "horizonte",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "SUBS", "class_name": "Subscription" },
      { "name": "CONFIG", "class_name": "Config" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Subscription", "Config"] }
  ],
  "observability": { "enabled": true }
}
